{
  "name": "neon-tempestad",
  "productName": "Neón Tempestad",
  "version": "1.2.0",
  "description": "Roguelike de acción 2D en HTML5 Canvas y JavaScript puro",
  "main": "js/main.js",
  "author": "thaigo naboni",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node tools/build-exe.js",
    "test": "node tools/smoke.js",
    "test:browser": "node tools/browser.js",
    "www": "node tools/build-www.js",
    "android": "node tools/build-www.js && npx cap sync android && node tools/android-setup.js",
    "android:open": "npx cap open android",
    "bump": "node tools/bump.js",
    "apk": "node tools/build-apk.js",
    "release": "node tools/release.js"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.neontempestad.juego",
    "productName": "Neón Tempestad",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "html/**",
      "css/**",
      "js/**"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "NeonTempestad-${version}-portable.exe"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true
  }
}
