rules_version = '2';
// Reglas de Firestore de Neón Tempestad. Se pegan en la consola de Firebase › Firestore › Reglas › Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    // Nombres de usuario de las cuentas con correo real (y los clásicos, que se reservan al entrar)
    match /names/{n} {
      allow read: if true;
      allow create: if request.auth != null
        && n.matches('^[a-z0-9_-]{3,16}$')
        && request.resource.data.keys().hasOnly(['uid','user'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.user is string && request.resource.data.user.lower() == n
        && (
          // cuenta clásica: solo su propio nombre
          request.auth.token.email == n + '@neontempestad.game'
          // cuenta con correo: un único nombre, creado junto con owners/{uid}
          || (!request.auth.token.email.matches('.*@neontempestad[.]game$')
              && !exists(/databases/$(database)/documents/owners/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/owners/$(request.auth.uid)).data.name == n)
        );
      allow update, delete: if false;
    }
    match /owners/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name'])
        && getAfter(/databases/$(database)/documents/names/$(request.resource.data.name)).data.uid == uid;
      allow update, delete: if false;
    }
    // Clasificación: una colección por dificultad (0 = Paseo … 4 = Pesadilla) y una por desafío diario (dAAAAMMDD).
    // Una sola entrada por jugador y dificultad: el documento se llama como su uid y solo se reemplaza por una marca mayor.
    function okBoard(diff) { return diff in ['0','1','2','3','4'] || diff.matches('^d[0-9]{8}$'); }
    function okScore(d) {
      return d.keys().hasOnly(['user','uid','ch','lvl','loop','time','kills','stages','win','score','date'])
        && d.uid == request.auth.uid
        // solo puedes publicar con tu propio nombre: el del usuario clásico o el reservado por tu cuenta de correo
        && (request.auth.token.email == d.user.lower() + '@neontempestad.game'
            || get(/databases/$(database)/documents/names/$(d.user.lower())).data.uid == request.auth.uid)
        && d.score is int && d.score >= 0 && d.score <= 100000000
        && d.lvl is int && d.lvl >= 1 && d.lvl <= 999
        && d.loop is int && d.loop >= 1 && d.loop <= 999
        && d.time is int && d.time >= 0
        && d.ch is string && d.ch.size() <= 24;
    }
    match /boards/{diff}/scores/{id} {
      allow read: if okBoard(diff);
      allow create: if request.auth != null && okBoard(diff) && id == request.auth.uid
        && okScore(request.resource.data);
      allow update: if request.auth != null && okBoard(diff) && id == request.auth.uid
        && okScore(request.resource.data) && request.resource.data.score > resource.data.score;
      // nadie puede borrar puntuaciones, ni siquiera las propias
      allow delete: if false;
    }
  }
}
